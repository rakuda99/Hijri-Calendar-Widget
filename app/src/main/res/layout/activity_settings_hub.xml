<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hub_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- App Branding -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hijri Widget"
            android:textColor="#E0E0E0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="16dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Professional Series"
            android:textColor="#8ACCC9"
            android:textSize="12sp"
            android:layout_marginBottom="32dp"
            android:textAllCaps="true"
            android:letterSpacing="0.2"/>

        <!-- LANGUAGE SELECTION SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_hub"
            android:padding="12dp"
            android:layout_marginBottom="24dp">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App Language / لغة التطبيق"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:gravity="center">
                
                <Button
                    android:id="@+id/btn_lang_ar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="عربي"
                    android:backgroundTint="#2E2E2E"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                
                <Button
                    android:id="@+id/btn_lang_en"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="English"
                    android:backgroundTint="#2E2E2E"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ADD TO HOME SCREEN SECTION -->
        <TextView
            android:id="@+id/section_add_en"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADD TO HOME SCREEN"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:textStyle="bold"
            android:textAllCaps="true"/>
        <TextView
            android:id="@+id/section_add_ar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إضافة للشاشة"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:textStyle="bold"
            android:gravity="right"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:id="@+id/btn_pin_clock_fancy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_hub"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/img_btn_clock"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="#6200EE"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/txt_add_clock_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clock"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/txt_add_clock_ar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ساعة"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_pin_calendar_fancy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_hub"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/img_btn_calendar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="#009688"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/txt_add_calendar_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calendar"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/txt_add_calendar_ar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تقويم"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_pin_prayer_fancy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_hub"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/img_btn_prayer"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="#FF9800"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/txt_add_prayer_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayers"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/txt_add_prayer_ar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صلاة"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- WIDGET SETTINGS SECTION -->
        <TextView
            android:id="@+id/section_settings_en"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:textStyle="bold"
            android:textAllCaps="true"/>
        <TextView
            android:id="@+id/section_settings_ar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الإعدادات"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:textStyle="bold"
            android:gravity="right"/>

        <!-- Grid for Settings -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:id="@+id/btn_goto_clock_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card_hub"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="#6200EE"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_settings_clock_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clock Settings"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/txt_settings_clock_ar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="إعدادات الساعة"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_goto_calendar_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card_hub"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="#009688"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_settings_calendar_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calendar Settings"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/txt_settings_calendar_ar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="إعدادات التقويم"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_goto_prayer_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card_hub"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="#FF9800"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_settings_prayer_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prayer Settings"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/txt_settings_prayer_ar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="إعدادات الصلاة"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_goto_backup_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card_hub"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_save"
                    app:tint="#607D8B"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_settings_backup_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Backup &amp; Tools"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/txt_settings_backup_ar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="النسخ والاحتياط"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

        </GridLayout>

        <!-- HELP & ABOUT -->
        <LinearLayout
            android:id="@+id/btn_goto_help_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_hub"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="40dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#AAAAAA"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/txt_help_en"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/txt_help_ar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المساعدة"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v4.9 BUILD 49"
            android:textColor="#444444"
            android:textSize="10sp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
