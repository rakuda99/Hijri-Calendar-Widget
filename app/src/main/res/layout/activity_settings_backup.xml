<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backup &amp; Storage\n(النسخ والاحتياط)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btn_export_settings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="EXPORT TO CLIPBOARD\n(نسخ الإعدادات للحافظة)"
            android:backgroundTint="#607D8B"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_import_settings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="IMPORT FROM CLIPBOARD\n(استيراد من الحافظة)"
            android:backgroundTint="#FF5722"
            android:layout_marginBottom="40dp"/>
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Use the main hub 'ADD' buttons if you want the system to add the widget automatically. You can also add them manually from your home screen."
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Use these buttons only if you want the system to add the widget automatically. You can also add them manually from your home screen."
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
