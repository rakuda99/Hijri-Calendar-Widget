<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:gravity="center"
    android:padding="4dp">

    <!-- Header Section (Clock and Countdown) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/tajawal"
            android:visibility="gone"
            android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2" />
    </LinearLayout>

    <!-- Mode: Next Prayer Only Prominent Box -->
    <LinearLayout
        android:id="@+id/ll_next_prayer_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/prayer_bg_glass"
        android:visibility="gone">
        <TextView android:id="@+id/tv_single_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الصلاة القادمة" android:textColor="#FFFFFF" android:textSize="20sp" android:maxLines="1" android:textStyle="bold" android:fontFamily="@font/tajawal" android:shadowColor="#80000000" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="3"/>
        <TextView android:id="@+id/tv_single_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#FBCD34" android:textSize="28sp" android:maxLines="1" android:textStyle="bold" android:fontFamily="@font/tajawal" android:shadowColor="#80000000" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="3"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_all_prayers_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp">

        <LinearLayout android:id="@+id/ll_fajr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/tv_fajr_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" />
            <TextView android:id="@+id/tv_fajr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#BBBBBB" android:textSize="14sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/ll_sunrise" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/tv_sunrise_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الشروق" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" />
            <TextView android:id="@+id/tv_sunrise_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#BBBBBB" android:textSize="14sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ll_dhuhr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/tv_dhuhr_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" />
            <TextView android:id="@+id/tv_dhuhr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#BBBBBB" android:textSize="14sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ll_asr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/tv_asr_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" />
            <TextView android:id="@+id/tv_asr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#BBBBBB" android:textSize="14sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ll_maghrib" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/tv_maghrib_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" />
            <TextView android:id="@+id/tv_maghrib_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#BBBBBB" android:textSize="14sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ll_isha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/tv_isha_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" />
            <TextView android:id="@+id/tv_isha_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#BBBBBB" android:textSize="14sp" android:maxLines="2" android:textStyle="bold" android:fontFamily="@font/tajawal" android:gravity="center" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بقي: --"
        android:textColor="#FBCD34"
        android:textSize="15sp"
        android:maxLines="1"
        android:textStyle="bold"
        android:fontFamily="@font/tajawal"
        android:visibility="visible"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1"/>

</LinearLayout>
