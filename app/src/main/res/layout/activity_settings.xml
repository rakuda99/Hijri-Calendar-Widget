<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal"/>

        <!-- Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/settings_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#F5F5F5"
            style="@style/Widget.MaterialComponents.TabLayout.Colored">
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clock (الساعة)" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendar (التقويم)" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backup (النسخ)" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Section: Home Screen Pins -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">
            <Button
                android:id="@+id/btn_pin_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Clock\n(إضافة الساعة)"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btn_pin_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Calendar\n(إضافة التقويم)"
                android:textSize="11sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- CLOCK SETTINGS CONTAINER -->
        <LinearLayout
            android:id="@+id/container_clock_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clock Widget (إعدادات الساعة)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#6200EE"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Clock Specific Spinners/Switches (Copied from below) -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_language" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_language" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Digit Style (شكل الأرقام)" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_digit_style" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_show_day_arabic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_show_day_arabic" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_show_day_english" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_show_day_english" android:layout_marginBottom="4dp"/>
            
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_day_orientation" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_day_orientation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_clock_color" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_clock_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_clock_size" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_clock_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_show_clock_visibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_show_clock" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_hijri_color" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_hijri_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_hijri_size" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_hijri_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_show_h" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_show_h" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_show_hijri_visibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_show_hijri" android:layout_marginBottom="4dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hijri Adjustment (تعديل الهجري)" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_hijri_correction" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="16dp"/>

            <Button android:id="@+id/btn_sync_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sync Time / مزامنة الوقت" android:backgroundTint="#F44336" android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_greg_color" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_greg_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_greg_size" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_greg_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_show_m" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_show_m" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_show_greg_visibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_show_greg" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_arabic_ampm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_arabic_ampm" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_use_24h" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_use_24h" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_pad_dates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_pad_dates" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_background" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_bg_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_month_format" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_month_format" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <!-- CALENDAR SETTINGS CONTAINER -->
        <LinearLayout
            android:id="@+id/container_calendar_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calendar Settings (إعدادات التقويم)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#009688"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_month_orientation" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_month_orientation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_month_day_language" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_month_day_language" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_week_start" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_week_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Greg Color (ميلادي)" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_month_greg_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hijri Color (هجري)" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_month_hijri_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today Circle (دائرة اليوم)" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_month_today_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Event Dot (نقطة الموعد)" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_month_event_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Day Size (حجم الأرقام)" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinner_month_day_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_month_day_bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bold (تغميق)" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_month_hollow_circle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hollow (مفرغة)" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_month_show_arrows" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Arrows (أسهم)" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_month_open_app" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open App (فتح التطبيق)" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_month_show_greg" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Greg (إظهار الميلادي)" android:layout_marginBottom="4dp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_month_show_hijri" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Hijri (إظهار الهجري)" android:layout_marginBottom="16dp"/>

            <Button android:id="@+id/btn_perm_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calendar Permission / صلاحية التقويم" android:backgroundTint="#FF9800" android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- BACKUP SETTINGS CONTAINER -->
        <LinearLayout
            android:id="@+id/container_backup_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backup &amp; Storage (النسخ والحفظ)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#607D8B"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_export_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export Settings / نسخ للحافظة"
                android:backgroundTint="#607D8B"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_import_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import Settings / استيراد"
                android:backgroundTint="#FF5722"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <!-- Global Update Button -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_update"
            android:padding="12dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version 4.6 - Tabs &amp; Shortcuts"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:textColor="#9E9E9E"/>

    </LinearLayout>
</ScrollView>
